{
  "problem": [
    {
      "start": 0.1,
      "end": 3.23,
      "text": "當銀行的 SQL 欄位定義變動，"
    },
    {
      "start": 3.23,
      "end": 6.75,
      "text": "風險指標與管理報表可能一路受到影響。"
    },
    {
      "start": 6.7,
      "end": 10.64,
      "text": "工程師需要跨多份腳本追查下游欄位，"
    },
    {
      "start": 10.64,
      "end": 12.96,
      "text": "再把依據交給覆核者。"
    },
    {
      "start": 12.96,
      "end": 16.34,
      "text": "這支影片展示 SQL SPA Tools 與"
    },
    {
      "start": 16.34,
      "end": 21.04,
      "text": "Microsoft 365 Copilot Chat 如何協作："
    },
    {
      "start": 21.04,
      "end": 22.36,
      "text": "先建立可追溯證據，"
    },
    {
      "start": 22.36,
      "end": 23.82,
      "text": "再由人員作最後判斷。"
    }
  ],
  "security": [
    {
      "start": 0.1,
      "end": 4.79,
      "text": "原始 SQL 只在使用者的本機瀏覽器做靜態分析。"
    },
    {
      "start": 4.74,
      "end": 6.86,
      "text": "工具產生最小化摘要預覽，"
    },
    {
      "start": 6.86,
      "end": 9.17,
      "text": "操作者檢查物件名稱與內容，"
    },
    {
      "start": 9.17,
      "end": 11.47,
      "text": "分別確認後下載 JSON，"
    },
    {
      "start": 11.47,
      "end": 14.84,
      "text": "再手動交給 Copilot Chat。"
    },
    {
      "start": 14.84,
      "end": 17.09,
      "text": "若資料分類有疑慮，"
    },
    {
      "start": 17.09,
      "end": 19.35,
      "text": "流程便停在上傳前。"
    },
    {
      "start": 19.35,
      "end": 23.24,
      "text": "Copilot 不連資料庫、不執行 SQL，"
    },
    {
      "start": 23.24,
      "end": 25.01,
      "text": "也不批准變更或部署。"
    }
  ],
  "impact": [
    {
      "start": 0.1,
      "end": 3.01,
      "text": "現在看固定的合成案例。"
    },
    {
      "start": 2.96,
      "end": 5.62,
      "text": "來源表的客戶分群欄位，"
    },
    {
      "start": 5.62,
      "end": 8.53,
      "text": "型別長度從二十擴為四十。"
    },
    {
      "start": 8.53,
      "end": 12.54,
      "text": "SQL Compare 呈現一項欄位定義修改；"
    },
    {
      "start": 12.54,
      "end": 15.5,
      "text": "操作者需根據這個畫面人工核對變更。"
    },
    {
      "start": 15.5,
      "end": 18.16,
      "text": "載入下游合成 SQL 後，"
    },
    {
      "start": 18.16,
      "end": 20.62,
      "text": "欄位對照表共有四筆關係，"
    },
    {
      "start": 20.62,
      "end": 23.69,
      "text": "其中兩筆指向未變更的客戶編號。"
    },
    {
      "start": 23.69,
      "end": 25.83,
      "text": "就這個變更欄位而言，"
    },
    {
      "start": 25.83,
      "end": 27.76,
      "text": "預期影響只剩兩項："
    },
    {
      "start": 27.76,
      "end": 30.98,
      "text": "管理報表的分群標籤屬直接關係，"
    },
    {
      "start": 30.98,
      "end": 34.2,
      "text": "風險分群的風險級距屬間接關係。"
    },
    {
      "start": 34.2,
      "end": 36.37,
      "text": "畫面上的合成名稱分別是 DEMO MONTHLY"
    },
    {
      "start": 36.37,
      "end": 38.37,
      "text": "REPORT 的 SEGMENT LABEL，"
    },
    {
      "start": 38.37,
      "end": 40.81,
      "text": "以及 DEMO RISK SEGMENTATION 的"
    },
    {
      "start": 40.81,
      "end": 41.85,
      "text": "RISK BUCKET。"
    },
    {
      "start": 41.85,
      "end": 46.03,
      "text": "這份清單只反映已載入腳本的靜態分析候選，"
    },
    {
      "start": 46.03,
      "end": 49.16,
      "text": "不能推論未載入的流程沒有影響，"
    },
    {
      "start": 49.16,
      "end": 51.04,
      "text": "仍需要工程師覆核。"
    }
  ],
  "copilot": [
    {
      "start": 0.1,
      "end": 6.47,
      "text": "接著，操作者把已核對的變更物件、欄位和前後型別填入摘要預覽。"
    },
    {
      "start": 6.42,
      "end": 9.3,
      "text": "JSON 以 operator entered 和"
    },
    {
      "start": 9.3,
      "end": 12.18,
      "text": "not verified by tool 標記來源，"
    },
    {
      "start": 12.18,
      "end": 13.73,
      "text": "清楚區分人工輸入與工具證據。"
    },
    {
      "start": 13.73,
      "end": 17.43,
      "text": "固定提示要求 Copilot 分開呈現人工描述與"
    },
    {
      "start": 17.43,
      "end": 19.35,
      "text": "impacts 血緣證據，"
    },
    {
      "start": 19.35,
      "end": 21.86,
      "text": "每項影響主張都要能回查 JSON。"
    },
    {
      "start": 21.86,
      "end": 27.26,
      "text": "匯出內容不含原始 SQL、運算式、檔名或完整錯誤訊息；"
    },
    {
      "start": 27.26,
      "end": 30.25,
      "text": "但物件與欄位名稱仍需人工檢查。"
    },
    {
      "start": 30.25,
      "end": 34.67,
      "text": "個人帳戶的文字探索曾產生符合提示的整理結果；"
    },
    {
      "start": 34.67,
      "end": 38.09,
      "text": "銀行核准租用戶與附件流程尚未驗收。"
    }
  ],
  "warning": [
    {
      "start": 0.1,
      "end": 2.1,
      "text": "再看警告案例。"
    },
    {
      "start": 2.05,
      "end": 5.73,
      "text": "合成 SQL 刻意省略 PIVOT 的 IN 清單，"
    },
    {
      "start": 5.73,
      "end": 7.29,
      "text": "摘要保留一筆解析警告。"
    },
    {
      "start": 7.29,
      "end": 10.24,
      "text": "Copilot 的整理若漏掉警告，"
    },
    {
      "start": 10.24,
      "end": 13.01,
      "text": "或把沒有找到的關係說成沒有影響，"
    },
    {
      "start": 13.01,
      "end": 14.4,
      "text": "就要記為未通過，"
    },
    {
      "start": 14.4,
      "end": 16.31,
      "text": "由工程師回到本機補查。"
    },
    {
      "start": 16.31,
      "end": 18.14,
      "text": "警告情境提醒我們："
    },
    {
      "start": 18.14,
      "end": 21.8,
      "text": "清單完整性受解析能力與載入範圍限制，"
    },
    {
      "start": 21.8,
      "end": 24.24,
      "text": "不能拿它單獨做放行決策。"
    },
    {
      "start": 24.24,
      "end": 30.01,
      "text": "靜態分析不涵蓋未載入的程序、排程、動態 SQL 和外部報表。"
    },
    {
      "start": 30.01,
      "end": 32.57,
      "text": "空結果不等於沒有風險。"
    }
  ],
  "regression": [
    {
      "start": 0.1,
      "end": 3.5,
      "text": "工具層的 Colab full 回歸，"
    },
    {
      "start": 3.5,
      "end": 5.29,
      "text": "實際通過三十項檢查："
    },
    {
      "start": 5.29,
      "end": 10.12,
      "text": "十項 Node 契約、十二頁瀏覽器載入、四項主要操作，"
    },
    {
      "start": 10.12,
      "end": 11.73,
      "text": "以及四項個資檢查。"
    },
    {
      "start": 11.68,
      "end": 13.94,
      "text": "另外產生一千筆合成案例，"
    },
    {
      "start": 13.94,
      "end": 16.58,
      "text": "目前只是 prepared，"
    },
    {
      "start": 16.58,
      "end": 17.9,
      "text": "尚未逐筆執行。"
    },
    {
      "start": 17.9,
      "end": 21.67,
      "text": "這些結果不等於 Copilot 回答品質，"
    },
    {
      "start": 21.67,
      "end": 23.64,
      "text": "也不等於銀行流程驗收。"
    }
  ],
  "measurement": [
    {
      "start": 0.1,
      "end": 3.05,
      "text": "效益要用配對量測回答。"
    },
    {
      "start": 3.0,
      "end": 5.15,
      "text": "計畫以同一組合成案例，"
    },
    {
      "start": 5.15,
      "end": 7.1,
      "text": "比較人工與原型流程，"
    },
    {
      "start": 7.1,
      "end": 9.25,
      "text": "至少進行三組真人試次，"
    },
    {
      "start": 9.25,
      "end": 13.55,
      "text": "記錄完成時間、步驟數、影響命中、漏列與誤列，"
    },
    {
      "start": 13.55,
      "end": 19.21,
      "text": "還要檢查 Copilot 回答是否有 JSON 證據支持，"
    },
    {
      "start": 19.21,
      "end": 21.36,
      "text": "以及警告是否正確揭露。"
    },
    {
      "start": 21.36,
      "end": 23.79,
      "text": "目前配對紀錄尚未實測，"
    },
    {
      "start": 23.79,
      "end": 26.66,
      "text": "因此沒有可報告的節省比例。"
    }
  ],
  "next": [
    {
      "start": 0.1,
      "end": 6.34,
      "text": "目前原型已具備摘要預覽與確認、正常合成案例、預期影響清單，"
    },
    {
      "start": 6.34,
      "end": 8.27,
      "text": "以及解析警告情境。"
    },
    {
      "start": 8.22,
      "end": 11.5,
      "text": "下一步是確認官方規則與資料治理要求，"
    },
    {
      "start": 11.5,
      "end": 17.32,
      "text": "在銀行核准的 Microsoft 365 環境完成附件流程演練，"
    },
    {
      "start": 17.32,
      "end": 19.13,
      "text": "再回填配對量測結果。"
    },
    {
      "start": 19.13,
      "end": 22.75,
      "text": "今天展示的是可檢查的原型流程。"
    },
    {
      "start": 22.75,
      "end": 25.81,
      "text": "讓 Copilot 整理分析證據，"
    },
    {
      "start": 25.81,
      "end": 28.51,
      "text": "讓風險管理覆核者保留最終判斷。"
    }
  ]
}